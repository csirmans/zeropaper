{
  "sandbox": {
    "enabled": true,
    "mode": "auto-allow",
    "allowUnsandboxedCommands": false,
    "filesystem": {
      "allowWrite": ["./", "~/.zeropaper", "~/.claude", "~/.claude.json"],
      "denyWrite": ["~/.ssh", "~/.aws", "//etc", "//root"],
      "denyRead": ["~/.ssh", "~/.aws", "./.env", ".env"]
    }
  }
}
